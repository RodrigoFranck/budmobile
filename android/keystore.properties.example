# Copy to keystore.properties and fill in after creating your release keystore.
# Android Studio: Build → Generate Signed App Bundle / APK → Create new...
# CLI example (store outside the repo):
#   keytool -genkeypair -v -storetype JKS -keyalg RSA -keysize 2048 -validity 10000 \
#     -storepass YOUR_STORE_PASSWORD -keypass YOUR_KEY_PASSWORD \
#     -alias bud-release -keystore /path/to/bud-release.keystore \
#     -dname "CN=Bud, OU=Mobile, O=Bud, L=City, ST=State, C=BR"
#
# storeFile path is relative to the android/ directory.

storeFile=../bud-release.keystore
storePassword=
keyAlias=bud-release
keyPassword=
