{
  "expo": {
    "name": "Bud.",
    "slug": "budmobile",
    "scheme": "com.bud.app",
    "version": "2.0.25",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#171310"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.bud.budios",
      "googleServicesFile": "./ios/budmobile/GoogleService-Info.plist",
      "usesAppleSignIn": true,
      "buildNumber": "36",
      "associatedDomains": [
        "applinks:falecombud.com.br"
      ],
      "entitlements": {
        "aps-environment": "development",
        "com.apple.developer.associated-domains": [
          "applinks:falecombud.com.br"
        ]
      },
      "infoPlist": {
        "NSCameraUsageDescription": "Bud precisa acessar a câmera para você tirar uma foto e anexar no chat ou no suporte.",
        "NSMicrophoneUsageDescription": "Bud precisa acessar o microfone para conversas de voz.",
        "NSPhotoLibraryUsageDescription": "Bud precisa acessar suas fotos para anexar um print no suporte.",
        "NSFaceIDUsageDescription": "Bud usa o Face ID para desbloquear o app.",
        "ITSAppUsesNonExemptEncryption": false,
        "UIUserInterfaceStyle": "Automatic"
      },
      "scheme": "com.bud.app"
    },
    "android": {
      "googleServicesFile": "./android/app/google-services.json",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#B0EDEE"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.falecombud.bud",
      "permissions": [
        "POST_NOTIFICATIONS",
        "READ_MEDIA_IMAGES",
        "RECORD_AUDIO",
        "USE_BIOMETRIC",
        "USE_FINGERPRINT"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ],
          "data": [
            {
              "scheme": "https",
              "host": "falecombud.com.br",
              "pathPrefix": "/nativelink"
            }
          ]
        }
      ]
    },
    "extra": {
      "eas": {
        "projectId": ""
      }
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "Bud precisa acessar suas fotos para anexar um print no suporte.",
          "cameraPermission": "Bud precisa acessar a câmera para você tirar uma foto e anexar no chat ou no suporte."
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Bud usa o Face ID para desbloquear o app."
        }
      ],
      "expo-apple-authentication",
      "@react-native-firebase/app",
      "@react-native-firebase/messaging",
      "@react-native-firebase/analytics",
      [
        "expo-build-properties",
        {
          "ios": {
            "useFrameworks": "static",
            "forceStaticLinking": [
              "RNFBApp",
              "RNFBMessaging",
              "RNFBAnalytics",
              "livekit-react-native",
              "livekit-react-native-webrtc"
            ]
          }
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#ffffff"
        }
      ]
    ],
    "web": {
      "favicon": "./assets/favicon.png"
    }
  }
}
