{
  "expo": {
    "name": "Bud.",
    "slug": "budmobile",
    "scheme": "com.bud.app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#AEECEF"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.bud.app",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "Bud precisa acessar o microfone para conversas de voz.",
        "ITSAppUsesNonExemptEncryption": false
      },
      "scheme": "com.bud.app"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#AEECEF"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.falecombud.bud",
      "permissions": ["RECORD_AUDIO"]
    },
    "plugins": [
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#ffffff"
        }
      ]
    ],
    "web": {
      "favicon": "./assets/favicon.png"
    }
  }
}
