index 0000000..7c23f8d
--- /dev/null
+++ b/android/expo-gradle-plugin/expo-autolinking-plugin-shared/src/main/kotlin/expo/modules/plugin/NodeBinary.kt
@@ -0,0 +1,15 @@
+package expo.modules.plugin
+
+/**
+ * Resolves the Node.js binary for Gradle subprocesses.
+ * Android Studio does not inherit nvm/fnm PATH; the app sets [EXPO_AUTO_LINKING_NODE_PROPERTY] from settings.gradle.
+ */
+object NodeBinary {
+  const val EXPO_AUTO_LINKING_NODE_PROPERTY = "expo.autolinking.nodeBinary"
+
+  fun path(): String {
+    System.getenv("NODE_BINARY")?.trim()?.takeIf { it.isNotEmpty() }?.let { return it }
+    System.getProperty(EXPO_AUTO_LINKING_NODE_PROPERTY)?.trim()?.takeIf { it.isNotEmpty() }?.let { return it }
+    return "node"
+  }
+}
